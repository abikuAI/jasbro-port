<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline restore.

  This machine's schannel TLS stack cannot complete a handshake
  (SEC_E_NO_CREDENTIALS), so any NuGet source lookup fails. The port's
  projects deliberately reference only each other and pull no external
  packages, so clearing every source makes restore fully offline and fast.

  If a package is ever genuinely needed, add it as a local folder source
  rather than restoring network access.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
