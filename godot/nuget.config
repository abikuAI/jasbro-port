<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet configuration for the Godot presentation layer.

  Two things are going on here, both necessary on this machine:

  1. <clear/> removes every inherited source, including nuget.org. schannel TLS is broken here
     (SEC_E_NO_CREDENTIALS), so any attempt to reach a remote feed fails slowly and confusingly.

  2. Godot ships its own SDK packages INSIDE the editor download, at
     tools/godot/Godot_v4.7.2-stable_mono_win64/GodotSharp/Tools/nupkgs
     Adding that as a local source is what makes an offline Godot C# build work at all.

  Keep the version in the csproj and the path here in step: bumping the editor means the feed
  directory changes too.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="godot-local" value="..\tools\godot\Godot_v4.7.2-stable_mono_win64\GodotSharp\Tools\nupkgs" />
  </packageSources>
</configuration>
