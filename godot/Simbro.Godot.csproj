<Project Sdk="Godot.NET.Sdk/4.7.2">
  <!--
    The Godot presentation layer.

    Deliberately thin. It references Simbro.Core, which knows nothing about Godot — no Godot
    types appear in the domain assembly at all. That separation is what makes this engine choice
    reversible, and what lets the simulation be tested in a plain `dotnet run` with no engine boot.

    net8.0 matches both Godot 4.7.2 and Simbro.Core.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Simbro.Godot</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <!-- Godot generates its own assembly info; ours would collide. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\port\Simbro.Core\Simbro.Core.csproj" />
  </ItemGroup>
</Project>
